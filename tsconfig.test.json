{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // Tests run through vitest, which resolves extensionless relative imports.
    // The published build stays NodeNext — this config only typechecks.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
